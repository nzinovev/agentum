# Application environment for local development. Copy to .env and export its
# values before starting the app; Agentum does not load .env itself.
# docker compose reads .env for AGENTUM_PG_PORT. Set the same port in the DSN.
AGENTUM_PG_PORT=5432
AGENTUM_DATABASE_URL='postgres://agentum:agentum@localhost:5432/agentum?sslmode=disable&search_path=agentum'
AGENTUM_HTTP_ADDR=:8080
AGENTUM_LOG_LEVEL=info
AGENTUM_TENANT_ID=00000000-0000-0000-0000-000000000001
AGENTUM_OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Execution. Empty adapter and binary values select the registry defaults.
AGENTUM_PACKS_DIR=packs
AGENTUM_WORKER_POOL_SIZE=1
AGENTUM_JOB_MAX_ATTEMPTS=3
AGENTUM_EXECUTION_ADAPTER=
AGENTUM_RUNTIME_BINARY=
# Zero disables these invocation limits; first-event timeout is separate.
AGENTUM_HARD_TIMEOUT_SECONDS=0
AGENTUM_IDLE_TIMEOUT_SECONDS=0
AGENTUM_FIRST_EVENT_TIMEOUT_SECONDS=120

# Zero uses the check executor's default when a registry entry has no override.
AGENTUM_CHECK_TIMEOUT_SECONDS=0
AGENTUM_CHECK_MAX_OUTPUT_BYTES=0
AGENTUM_MODEL_TEST_MAX_SECONDS=120
AGENTUM_MODEL_TEST_RETENTION_MINUTES=60

# This directory must survive worktree cleanup. Policy is redact or reject.
AGENTUM_ARTIFACT_ROOT=.agentum/artifacts
AGENTUM_ARTIFACT_SCAN_POLICY=redact

# Publication is disabled by default. Enabling it requires a token with repository
# contents and pull-request write permissions. The token reaches only the publisher.
AGENTUM_PUBLISH_ENABLED=false
AGENTUM_PUBLISH_PROVIDER=github
AGENTUM_PUBLISH_TOKEN=
AGENTUM_PUBLISH_API_BASE=https://api.github.com
AGENTUM_PUBLISH_REMOTE=origin
# Empty: use the run's base_ref if it is a remote branch, else the default branch.
AGENTUM_PUBLISH_BASE_BRANCH=
